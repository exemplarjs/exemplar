{
  "$schema": "https://typedoc.org/schema.json",
  "name": "exemplar",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/xml",
    "packages/sax",
    "packages/dom",
    "packages/writer",
    "packages/canonical",
    "packages/validation",
    "packages/encodings-cjk",
    "packages/xinclude",
    "packages/catalog"
  ],
  "packageOptions": {
    "entryPoints": ["src/index.ts"],
    "excludeInternal": true,
    "excludePrivate": true,
    "disableSources": true,
    "readme": "none"
  },
  "out": "api",
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "none"
}
