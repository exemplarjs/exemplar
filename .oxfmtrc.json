{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "es5",
  "singleQuote": true,
  "printWidth": 120,
  "objectWrap": "collapse",
  "proseWrap": "always",
  "sortPackageJson": false,
  "sortImports": {
    "newlinesBetween": false,
    "customGroups": [
      { "groupName": "exemplar", "elementNamePattern": ["@exemplarjs/**"] },
      { "groupName": "package", "elementNamePattern": ["@/**"] }
    ],
    "groups": ["builtin", "external", "exemplar", "package", ["parent", "sibling", "index"]]
  },
  "ignorePatterns": [
    // pnpm rewrites these itself.
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    // Whitespace-sensitive test fixtures: reformatting them changes what is under test.
    "**/fixtures/",
    // API docs that TypeDoc generates.
    "/api/"
  ]
}
