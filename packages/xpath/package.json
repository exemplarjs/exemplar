{
  "name": "@exemplarjs/xpath",
  "version": "0.3.0",
  "description": "An XPath 3.1 processor over @exemplarjs/xdm trees",
  "license": "Apache-2.0",
  "homepage": "https://exemplar.l47.net",
  "keywords": [
    "xml",
    "xpath",
    "xpath-3.1",
    "query"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exemplarjs/exemplar.git",
    "directory": "packages/xpath"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "exemplar-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lean": {
      "exemplar-source": "./src/lean.ts",
      "types": "./dist/lean.d.ts",
      "default": "./dist/lean.js"
    },
    "./groups/*": {
      "exemplar-source": "./src/groups/*.ts",
      "types": "./dist/groups/*.d.ts",
      "default": "./dist/groups/*.js"
    },
    "./resolvers/directory": {
      "exemplar-source": "./src/resolvers/directory.ts",
      "types": "./dist/resolvers/directory.d.ts",
      "default": "./dist/resolvers/directory.js"
    },
    "./internal": {
      "exemplar-source": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "THIRD_PARTY_LICENSES"
  ],
  "scripts": {
    "clean:output": "rimraf dist .turbo coverage",
    "typecheck": "tsc --noEmit",
    "compile": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint"
  },
  "peerDependencies": {
    "@exemplarjs/writer": "workspace:*",
    "@exemplarjs/xdm": "workspace:*",
    "@exemplarjs/xml": "workspace:*"
  },
  "devDependencies": {
    "@exemplarjs/build-config": "workspace:*",
    "@exemplarjs/writer": "workspace:*",
    "@exemplarjs/xdm": "workspace:*",
    "@exemplarjs/xml": "workspace:*",
    "@fast-check/vitest": "catalog:",
    "rolldown": "catalog:"
  }
}
