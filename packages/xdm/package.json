{
  "name": "@exemplarjs/xdm",
  "version": "0.3.0",
  "description": "An XDM 3.1 tree built by @exemplarjs/xml, the data model for XPath, XQuery and XSLT",
  "license": "Apache-2.0",
  "homepage": "https://exemplar.l47.net",
  "keywords": [
    "xml",
    "xdm",
    "xpath",
    "data-model",
    "tree"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exemplarjs/exemplar.git",
    "directory": "packages/xdm"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "exemplar-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "exemplar-source": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "THIRD_PARTY_LICENSES"
  ],
  "scripts": {
    "clean:output": "rimraf dist .turbo coverage",
    "typecheck": "tsc --noEmit",
    "compile": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint"
  },
  "peerDependencies": {
    "@exemplarjs/xml": "workspace:*"
  },
  "devDependencies": {
    "@exemplarjs/build-config": "workspace:*",
    "@exemplarjs/sax": "workspace:*",
    "@exemplarjs/test-support": "workspace:*",
    "@exemplarjs/xml": "workspace:*",
    "@fast-check/vitest": "catalog:"
  }
}
